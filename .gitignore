# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# relatórios/dumps gerados localmente — podem conter dado real de produção
# (pagamento, avaliação nominal de entregador, schema completo do banco).
# Nunca versionar; ficam só na máquina que os gerou.
*.pdf
*.xlsx
schema_producao_dump.sql
restaurar-pedido-*.mjs
